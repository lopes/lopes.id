# general exclusions
.DS_Store
.hooks
.venv
venv

# secrets and captured analytics data (see .env.example)
.env
snapshots/

# terraform
terraform/.terraform/
*.tfstate
*.tfstate.*
terraform/*.tfvars
!terraform/*.tfvars.example

# quarto exclusions
/.quarto/
**/*.quarto_ipynb
_site
*.html
!_analytics.html
!decks/_partials/*.html
