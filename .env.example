# Configuration for scripts/analytics-snapshot.sh
#
# Copy to .env (git-ignored) and fill in. Values set in the environment take
# precedence over this file, so a one-off override needs no edit here.
#
#   cp .env.example .env


# Cloudflare API token. Read-only: it cannot change firewall or DNS settings.
#
# Create at: dash.cloudflare.com -> My Profile -> API Tokens -> Create Token
#            -> "Create Custom Token"
# Permissions (add both):
#   Zone    | Analytics         | Read
#   Account | Account Analytics | Read
# Zone Resources:    Include -> Specific zone -> lopes.id
# Account Resources: Include -> your account
#
# The token is shown exactly once at creation — copy it before closing the page.
CF_TOKEN=

# Zone ID for lopes.id.
# Find at: dash.cloudflare.com -> lopes.id -> Overview -> right sidebar,
#          under "API" (32-character hex string).
CF_ZONE_ID=

# Account ID.
# Find in any dashboard URL: dash.cloudflare.com/<account-id>/...
# It is also on Overview, in the same sidebar block as the Zone ID.
CF_ACCOUNT_ID=

# Web Analytics site tag. Optional — without it the script skips the
# beacon-level query and still captures everything drawn from zone logs.
# Find in the Web Analytics URL: .../web-analytics/overview?siteTag~in=<site-tag>
CF_SITE_TAG=
